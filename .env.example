# ==============================================================================
# G2G API v0.1 — Environment Configuration
# Copy this file to `.env` and fill in the layers you want to use.
# See `docs/CREDENTIALS.md` for step-by-step instructions to obtain each value.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Official G2G Seller OpenAPI v2 (https://open-api.g2g.com)
#    Required for: Official store, services, brands, products, offers, orders,
#                  inventory codes, and webhook logs.
# ------------------------------------------------------------------------------
G2G_API_KEY=
G2G_API_SECRET=
G2G_USER_ID=
# Optional override (defaults to https://open-api.g2g.com)
G2G_OPEN_API_BASE_URL=https://open-api.g2g.com

# ------------------------------------------------------------------------------
# 2. G2G Web Seller & Live Chat Session (https://sls.g2g.com + SendBird)
#    Required for: Web offer creation/editing on normal seller accounts,
#                  3-step web order delivery (start_deliver -> delivering -> delivered_qty),
#                  and live buyer SendBird DM chat.
# ------------------------------------------------------------------------------
G2G_SELLER_ID=
G2G_WEB_TOKEN=
# Optional refresh tokens (enables automatic JWT renewal on 401):
G2G_REFRESH_TOKEN=
G2G_LONG_LIVED_TOKEN=
G2G_ACTIVE_DEVICE_TOKEN=

# ------------------------------------------------------------------------------
# 3. Inbound Webhook Verification
#    Required for: POST /api/v0.1/webhook HMAC-SHA256 verification.
# ------------------------------------------------------------------------------
G2G_WEBHOOK_SECRET=
G2G_WEBHOOK_URL=https://your-domain.example.com/api/v0.1/webhook

# ------------------------------------------------------------------------------
# 4. Standalone REST Server (optional — `npm run dev:server`)
# ------------------------------------------------------------------------------
PORT=4080
# Optional bearer token to protect your own REST server routes:
SERVER_API_TOKEN=
